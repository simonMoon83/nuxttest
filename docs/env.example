# Environment variables for Nuxt3 + MSSQL Enterprise Application
# Copy this file to .env and update with your actual values

# --- Security (CRITICAL for Production) ---
# JWT Secret for token signing
# ⚠️  REQUIRED in production! Must be at least 32 characters
# Generate: openssl rand -base64 32
# Default is allowed ONLY in development (warning shown)
JWT_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwidXNlcm5hbWUiOiJhZG1pbiIsImVtYWlsIjoiYWRtaW5AZXhhbXBsZS5jb20iLCJmdWxsX25hbWUiOiJBZG1pbmlzdHJhdG9yIiwiaWF0IjoxNzAxMDAwMDAwLCJleHAiOjE3MDEwODAwMDB9.SIGNATURE_PLACEHOLDER

# Cookie security (set to true in production with HTTPS)
COOKIE_SECURE=false

# Node environment
NODE_ENV=development

# --- Database (MSSQL) ---
DB_HOST=infopath.iptime.org
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change-me
DB_NAME=nuxttest
DB_TRUST_SERVER_CERT=true

# Connection pool & timeouts
DB_POOL_MAX=50
DB_POOL_MIN=10
DB_POOL_IDLE_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000

# Optional retry controls
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=2000

# Initialize DB schema on boot (true/false)
# Set to false on first run to create tables
SKIP_DB_INIT=true

# File uploads mount point (inside container)
UPLOADS_DIR=/uploads

# --- InfluxDB (Optional - for k6 performance dashboards) ---
# INFLUX_URL=http://localhost:8086
# INFLUX_TOKEN=
# INFLUX_ORG=
INFLUX_BUCKET_TEST=testspc
INFLUX_BUCKET_SPEC=testspecspc

# --- Rate Limiting (Built-in, In-memory) ---
# Automatic protection enabled:
#   - Login: 5 attempts per 5 minutes per IP
#   - API: 60 requests per minute per IP
#   - Uploads: 10 files per 10 minutes per IP
# Note: For multi-node deployments, consider Redis-based rate limiting

# --- File Upload Security ---
# Configuration in nuxt.config.ts:
#   - Max size: 150MB per file
#   - Allowed: .jpg, .jpeg, .png, .gif, .webp, .pdf, .txt, .zip, .doc, .docx, .xls, .xlsx
#   - MIME type validation: ✓ (checks actual file content)
#   - Path traversal protection: ✓

# --- Monitoring & Alerts (Optional) ---
# Discord webhook URL for system alerts
# Create webhook: Discord Server → Settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Slack webhook URL for system alerts
# Create webhook: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Default Admin Account ---
# ⚠️  Change password immediately after first login!
#   Username: admin
#   Password: admin123
# In production, first login will require password change













