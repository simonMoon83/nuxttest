# --- Database (MSSQL) ---
DB_HOST=infopath.iptime.org
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change-me
DB_NAME=nuxttest
DB_TRUST_SERVER_CERT=true

# Connection pool & timeouts
DB_POOL_MAX=50
DB_POOL_MIN=10
DB_POOL_IDLE_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
# Optional retry controls
# DB_MAX_RETRIES=5
# DB_RETRY_DELAY_MS=2000

# Initialize DB schema on boot (true/false)
SKIP_DB_INIT=true

# File uploads mount point (inside container)
UPLOADS_DIR=/uploads

# --- Auth / App ---
# dev 컨테이너는 docker-compose에서 기본 development로 설정
